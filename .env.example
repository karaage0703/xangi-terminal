# HOST / PORT / ORIGIN / TERMINAL_TOKEN are for standalone mode only.
# Managed extension mode uses an automatically allocated loopback port and the xangi URL.
HOST=127.0.0.1
PORT=18920
# Set the exact browser origin when using a reverse proxy / Tailnet.
# ORIGIN=https://terminal.example.com
# A random token is created in .runtime/access-token if unset.
# TERMINAL_TOKEN=at-least-32-characters
# Commands have the permissions of the account running this server.
# CWD=/home/your-user/project
# Optional: exact account name injected by Tailscale Serve; loopback binding required.
# TRUSTED_TAILSCALE_LOGIN=you@example.com

# xangi連携: 画面で選ぶエージェントのAI設定を使用。LLM_* は不要。
# xangi Web UI origin on the same server (not the tool-server URL).
# XANGI_URL=http://127.0.0.1:18888
# XANGI_TOKEN=  # Only when the upstream requires bearer authentication.

# 単独利用時のみ: OpenAI互換APIのURLと実際のモデルIDを指定。
# AI未設定でも直接コマンドを実行できます。
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=
# 対応するプロバイダーでthinkingを無効化したい場合のみ指定。既定false。
# LLM_DISABLE_THINKING=true

# Optional: server-configured OpenAI-compatible backends for the AI selector.
# Replaces LLM_BASE_URL/LLM_MODEL/LLM_API_KEY when present; keep secrets in .env only.
# LLM_BACKENDS_JSON='[{"id":"local","name":"Local LLM","llmUrl":"http://127.0.0.1:8001/v1","model":"your-model","disableThinking":true}]'
