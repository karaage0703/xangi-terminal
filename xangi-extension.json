{
  "schemaVersion": 2,
  "id": "xangi-terminal",
  "displayName": "xangi-terminal",
  "description": "自然言語とシェルで操作するターミナルを開く",
  "version": "0.1.2",
  "entrypoint": "scripts/xangi-extension",
  "runtime": {
    "kind": "managed-http"
  },
  "permissions": [
    "xangiの拡張画面から同じ端末のターミナルを操作する"
  ],
  "setup": {
    "instructions": "XANGI_SETUP.md"
  },
  "ui": {
    "capability": "terminal.open",
    "path": "/ui"
  },
  "capabilities": [
    {
      "id": "terminal.open",
      "protocol": "http",
      "healthPath": "/health"
    }
  ]
}
